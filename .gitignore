# ================================
# KARVEAGENT - .gitignore
# ================================

# ---------- Environment / Secrets ----------
.env
.env.local
.env.development
.env.production
.env.test
*.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking / linting
.mypy_cache/
.ruff_cache/

# ---------- FastAPI / Backend ----------
*.log
logs/

# ---------- Node / React ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# React build
frontend/build/
frontend/dist/

# ---------- Vite ----------
.vite/

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS ----------
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~

# ---------- Database ----------
*.sqlite
*.sqlite3
*.db

# ---------- Redis ----------
dump.rdb

# ---------- AI / ML ----------
# Local model files
models/
*.gguf
*.bin
*.safetensors

# Vector databases / embeddings
chroma/
chroma_db/
vectorstore/
vectordb/
.faiss/

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.temp

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Generated files ----------
uploads/
downloads/
generated/